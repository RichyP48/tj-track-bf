# Frontend Environment Variables
REACT_APP_API_URL=http://localhost:8080/api/v1.0
REACT_APP_APP_NAME=TJ-Track
REACT_APP_VERSION=1.0.0
REACT_APP_ENVIRONMENT=development

# Backend Environment Variables (for production)
DATABASE_URL=jdbc:mysql://your-db-host:3306/tjtrack
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
JWT_SECRET=your-jwt-secret-key-min-256-bits
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# AWS Configuration (for deployment)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-west-1
S3_BUCKET_NAME=tj-track-frontend